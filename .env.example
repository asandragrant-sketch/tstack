# ==============================================================================
# TSTACK PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Core Application URL
NEXT_PUBLIC_APP_URL=https://tstack-ten.vercel.app

# 2. Authentication & Session Security (Required in Production)
JWT_SECRET=replace_with_64_character_cryptographic_random_secret

# 3. Authorized Owner Seed Credentials (Optional override for initial bootstrap)
ADMIN_SEED_PASSWORD_JACOB=replace_with_strong_owner_password_1
ADMIN_SEED_PASSWORD_BARON=replace_with_strong_owner_password_2

# 4. External Email Delivery Providers (Configure at least one for external Gmail alerts)
# Option A: Gmail App Password / Custom SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=d.jacobwebpro@gmail.com
SMTP_PASS=replace_with_16_char_gmail_app_password
NOTIFICATION_FROM_EMAIL=d.jacobwebpro@gmail.com

# Option B: Resend API
RESEND_API_KEY=re_replace_with_resend_api_key

# Option C: Web3Forms Webhook Key
WEB3FORMS_KEY=replace_with_web3forms_access_key

# 5. Stripe Live Payment Processing & Webhook Verification
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# 6. Optional OpenAI API Key (Enhances deterministic TSTACK AI Knowledge Engine)
OPENAI_API_KEY=sk-replace_with_optional_openai_api_key
